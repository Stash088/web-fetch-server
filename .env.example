# Comma-separated list of accepted Bearer tokens for the MCP endpoint.
# Each key = one user. API_KEY is a legacy alias for a single key.
API_KEYS=dev-secret-123
# API_KEY=change-me-strong-secret

# Antibot resilience (see README).
# TLS_FINGERPRINT=chrome       # chrome (uTLS) | off
# JS_RENDER=never              # never | auto | always
# JS_RENDER_TIMEOUT=30s
# CHROME_BIN=                  # auto-detect if empty
# RENDER_PROFILE_DIR=          # base dir for persistent browser profiles (default: tmpdir)
# RENDER_POOL_SIZE=1           # number of pooled render browsers (each with its own profile)

# Timeouts
# FETCH_TIMEOUT=20s            # SearXNG + page fetches
# PDF_FETCH_TIMEOUT=60s        # PDF fetches (only when larger than FETCH_TIMEOUT)
# PDF_MAX_FETCH_BYTES=8388608  # body cap for PDFs (parsed to text client-side)
# SEARCH_CATEGORIES=general,it # SearXNG categories for web_search; "it" adds the
                               # keyless IT verticals (stackoverflow, github, mdn)
                               # for engine consensus on tech queries

# TTL caches for MCP tools (0 = cache disabled)
# FETCH_CACHE_TTL=20m          # direct HTTP fetches
# RENDER_CACHE_TTL=5m          # headless-browser renders (shorter: cookies drift)
# SEARCH_CACHE_TTL=10m         # SearXNG search results