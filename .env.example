# Comma-separated list of accepted Bearer tokens for the MCP endpoint.
# Each key = one user. API_KEY is a legacy alias for a single key.
API_KEYS=dev-secret-123
# API_KEY=change-me-strong-secret

# Antibot resilience (see README).
# TLS_FINGERPRINT=chrome       # chrome (uTLS) | off
# JS_RENDER=never              # never | auto | always
# JS_RENDER_TIMEOUT=30s
# CHROME_BIN=                  # auto-detect if empty